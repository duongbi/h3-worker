# ============================================================================
#  Copy thành .env và điền. KHÔNG commit .env lên git.
#  Trên RunPod: điền các biến này ở phần Environment Variables của endpoint.
# ============================================================================

# --- Cloudflare R2 ----------------------------------------------------------
R2_BUCKET=h3-videos

# ĐÂY LÀ S3 API ENDPOINT, KHÔNG PHẢI custom domain công khai của bạn.
# Lấy ở Cloudflare: R2 → bucket → Settings → mục "S3 API".
# Dạng: https://<account_id>.r2.cloudflarestorage.com  (không kèm tên bucket)
# Nhầm chỗ này với custom domain sẽ lỗi ENOTFOUND <bucket>.<domain>.
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Nếu bucket đã gắn custom domain hoặc bật r2.dev → điền vào đây,
# worker sẽ trả URL công khai vĩnh viễn thay vì presigned URL.
# Để trống → worker trả presigned URL có hạn.
R2_PUBLIC_BASE_URL=
R2_PRESIGN_EXPIRY_SEC=604800

# --- ComfyUI / handler ------------------------------------------------------
COMFY_HOST=127.0.0.1:8188
COMFY_POLL_INTERVAL_MS=1000
# Phải NHỎ HƠN executionTimeout của endpoint để handler kịp trả lỗi đẹp
COMFY_MAX_WAIT_SEC=1800
OUTPUT_DIR=/comfyui/output
INPUT_DIR=/comfyui/input

# --- Chế độ POD (pod_server.py) ---------------------------------------------
# Chỉ có tác dụng khi Pod chạy `bash /pod-start.sh` thay cho /start.sh.
# Đặt các biến này ở RunPod → Pod → Environment Variables.
#
# ⚠ POD_API_KEY LÀ BẮT BUỘC khi chạy thật. Cổng proxy của Pod
#   (https://<podId>-8000.proxy.runpod.net) công khai trên Internet — trống key
#   thì ai biết URL cũng gửi job được và bạn trả tiền GPU cho họ.
#   Sinh nhanh:  openssl rand -hex 24
# POD_API_KEY=
# POD_PORT=8000
# Số job chạy song song. MỘT GPU thì để 1 — cho 2 chỉ làm cả hai job cùng chậm.
# POD_CONCURRENCY=1
# Giữ job đã xong trong RAM bao lâu (poller của backend còn hỏi lại được).
# POD_JOB_TTL_SEC=86400
# Vượt ngần này thì /run trả 503 để backend hoàn credit ngay, thay vì nhận rồi chết.
# POD_QUEUE_MAX=100
# Chờ ComfyUI khởi động tối đa bao lâu trước khi pod_server mở cổng.
# POD_COMFY_WAIT_SEC=900
# SageAttention 2.2 (−15…19% thời gian sampling). Cần wheel build cho sm_120;
# bản 1.0.6 trên PyPI KHÔNG đủ. Bật khi đã cài được.
# COMFY_SAGE_ATTENTION=0
# Cờ thêm cho ComfyUI. --highvram chỉ nên bật trên card 96GB.
# COMFY_ARGS=--listen 0.0.0.0 --port 8188

# --- Chỉ dùng khi test local ------------------------------------------------
# SERVE_API_LOCALLY=true

# --- Dùng cho scripts/*.mjs (test-endpoint, bench, test-pod) ----------------
# Đặt RUNPOD_BASE_URL → mọi script nói chuyện với POD.
# Bỏ trống → dùng RUNPOD_ENDPOINT_ID, tức Serverless. Đặt cả hai thì Pod thắng.
# RUNPOD_API_KEY=            # Pod: chính là POD_API_KEY. Serverless: API key tài khoản.
# RUNPOD_ENDPOINT_ID=
# RUNPOD_BASE_URL=https://<podId>-8000.proxy.runpod.net

# --- Dùng cho scripts/download_models.sh ------------------------------------
# HF_TOKEN=
