# ============================================================================
#  Copy thành .env và điền. KHÔNG commit .env lên git.
#  Trên RunPod: điền các biến này ở phần Environment Variables của endpoint.
# ============================================================================

# --- Cloudflare R2 ----------------------------------------------------------
R2_BUCKET=h3-videos

# ĐÂY LÀ S3 API ENDPOINT, KHÔNG PHẢI custom domain công khai của bạn.
# Lấy ở Cloudflare: R2 → bucket → Settings → mục "S3 API".
# Dạng: https://<account_id>.r2.cloudflarestorage.com  (không kèm tên bucket)
# Nhầm chỗ này với custom domain sẽ lỗi ENOTFOUND <bucket>.<domain>.
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Nếu bucket đã gắn custom domain hoặc bật r2.dev → điền vào đây,
# worker sẽ trả URL công khai vĩnh viễn thay vì presigned URL.
# Để trống → worker trả presigned URL có hạn.
R2_PUBLIC_BASE_URL=
R2_PRESIGN_EXPIRY_SEC=604800

# --- ComfyUI / handler ------------------------------------------------------
COMFY_HOST=127.0.0.1:8188
COMFY_POLL_INTERVAL_MS=1000
# Phải NHỎ HƠN executionTimeout của endpoint để handler kịp trả lỗi đẹp
COMFY_MAX_WAIT_SEC=1800
OUTPUT_DIR=/comfyui/output
INPUT_DIR=/comfyui/input

# --- Chỉ dùng khi test local ------------------------------------------------
# SERVE_API_LOCALLY=true

# --- Dùng cho scripts/curl_examples.sh --------------------------------------
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=

# --- Dùng cho scripts/download_models.sh ------------------------------------
# HF_TOKEN=
